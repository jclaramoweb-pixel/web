{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/post/:slug",
      "destination": "/crystal-river-fishing-reports/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/crystal-river-fishing-reports/",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "/crystal-river-fishing-reports/",
      "permanent": true
    },
    {
      "source": "/fishing-reports",
      "destination": "/crystal-river-fishing-reports/",
      "permanent": true
    },
    {
